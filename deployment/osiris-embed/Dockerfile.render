# Single-container Render deployment: the published OSIRIS image serves the app,
# and Nginx removes the upstream SAMEORIGIN framing restriction safely.
FROM ghcr.io/simplifaisoul/osiris:latest

USER root
RUN apk add --no-cache nginx gettext su-exec \
    && mkdir -p /run/nginx /var/log/nginx /etc/nginx/templates

WORKDIR /app
ENV PORT=10000

COPY deployment/osiris-embed/nginx.render.conf.template /etc/nginx/templates/osiris.conf.template

EXPOSE 10000

CMD ["/bin/sh", "-c", "set -eu; : \"\${EOC_ALLOWED_ORIGIN:?Set EOC_ALLOWED_ORIGIN to the exact EOC origin}\"; case \"$EOC_ALLOWED_ORIGIN\" in https://*|http://*) ;; *) echo 'EOC_ALLOWED_ORIGIN must start with http:// or https://' >&2; exit 1 ;; esac; su-exec nextjs env HOSTNAME=127.0.0.1 PORT=3000 node /app/server.js & envsubst '\${PORT} \${EOC_ALLOWED_ORIGIN}' < /etc/nginx/templates/osiris.conf.template > /etc/nginx/conf.d/default.conf; nginx -t; exec nginx -g 'daemon off;'"]
