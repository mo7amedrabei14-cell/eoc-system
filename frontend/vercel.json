{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), payment=(), geolocation=(self)"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "fix/ai-radar-hourly-github-only-2026-10-16": false,
      "feature/apify-social-radar-budget-2026-10-13": false,
      "fix/osiris-real-incident-validation-2026-10-13": false,
      "fix/social-search-budget-safe-2026-10-13": false,
      "fix/social-search-diagnostics-2026-10-14": false,
      "feature/owner-persistent-messages-wireless-field-2026-10-21": false
    }
  }
}
