	*  - الحذف من المخزن يحدث *بعد* تأكيد السيرفر فقط — لا فقد بيانات في أي حالة. */
	const flushWeatherSave = async ({ retryAll = false, manual = false } = {}) => {
		if (autoSaveTimerRef.current) {
			clearTimeout(autoSaveTimerRef.current);
