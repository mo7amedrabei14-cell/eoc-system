			if (res.ok) setDaily(await res.json());
		} catch (e) {}
	};
	// كل تغيير (وردية/تاريخ) → نحفظ أي رقم متكتب قبل التبديل (على الوردية القديمة)، وبعدين لوح نظيف وجلب جديد
	useEffect(() => {
		touchedRef.current = new Set();
