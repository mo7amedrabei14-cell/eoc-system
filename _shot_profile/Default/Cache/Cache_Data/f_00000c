	const WEATHER_BRANCH_ORDER = [
		19,
		13,
		20,
		8,
		32,
		12,
		26,
		29,
		15,
		16,
		9,
		25,
		21,
		17,
		14,
		31,
		27,
		18,
		24,
		22,
		7,
		23,
		28,
		30,
		10,
		11,
		6
	];
	const visibleBranches = (isGlobalWeather ? branches : wRegionBranches[userRegion] || []).slice().sort((a, b) => {
		const indexA = WEATHER_BRANCH_ORDER.indexOf(Number(a.id));
