				// السيرفر يعيد كل الورديات لهذا التاريخ (مطلوب لتصدير سجل الورديات الثلاث) —
				// جدول الإدخال لا يملأ إلا قيم الوردية المختارة فقط.
				const shiftRows = (data || []).filter((r) => r.shift === shift);
