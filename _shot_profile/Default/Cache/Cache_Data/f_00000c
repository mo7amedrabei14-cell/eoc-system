		let savedCount = 0;
		let failedGroups = 0;
		// 🧭 سبب فشل كل مجموعة — الرسالة للمستخدم تصف بالسبب الحقيقي بدل رسالة غامضة
		const failureReasons = {
			auth: 0,
			server: 0,
