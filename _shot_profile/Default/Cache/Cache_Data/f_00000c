							temp_max: r.temp_max ?? "",
							wind_min: r.wind_min ?? "",
							wind_max: r.wind_max ?? "",
							rain_min: r.rain_min ?? "",
							rain_max: r.rain_max ?? "",
							humidity_min: r.humidity_min ?? "",
							humidity_max: r.humidity_max ?? "",
							clouds_min: r.clouds_min ?? "",
							clouds_max: r.clouds_max ?? "",
							aqi_min: r.aqi_min ?? "",
							aqi_max: r.aqi_max ?? ""
