				// sentByBranch: بالضبط ما خرج على الشبكة، لكل خلية على حدة — هو الذي يبرر المسح لاحقاً.
				const sentByBranch = {};
				const bodyRows = Object.entries(group.rowsByBranch || {}).filter(([bid]) => allowedIds.has(Number(bid))).map(([bid, row]) => {
					const o = {
						branch_id: Number(bid),
						shift: group.shift
					};
					const sent = {};
					WEATHER_METRICS.forEach((m) => WEATHER_METRIC_FIELDS(m).forEach((f) => {
