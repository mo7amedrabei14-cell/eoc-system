				retryAll,
				manual
			}), 800);
			return;
		}
		const groups = Object.entries(pendingRowsRef.current).filter(([gk]) => retryAll || !snap ? true : gk === `${snap.date}|${snap.shift}`).map(([gk, rowsByBranch]) => {
			const [date, shiftKey] = gk.split("|");
			return {
				date,
				shift: shiftKey,
				rowsByBranch
			};
		});
