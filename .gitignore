# حماية ملف الباسوردات السري (أهم سطر)
.env

# منع رفع بيئة بايثون الوهمية (عشان مساحتها كبيرة)
.venv/
__pycache__/
*.pyc

# منع رفع مكتبات الفرونت إند التقيلة
node_modules/
dist/

# ملفات نظام التشغيل
.DS_Store

# أداة اختبار الموبايل (تجريبي فقط — لا يُرفَع أبداً)
.mobile-audit/

# نسخ احتياطية من ملف البيئة (أسرار اتصال) — تفضل خارج الجيت دائماً
.env.aiven-backup
.env.neon-backup

# نسخ احتياطية من قاعدة البيانات — ما تترفعش للمستودع أبداً
*.backup
*.dump
