# حماية ملف الباسوردات السري (أهم سطر)
.env

# منع رفع بيئة بايثون الوهمية (عشان مساحتها كبيرة)
.venv/
__pycache__/
*.pyc

# منع رفع مكتبات الفرونت إند التقيلة
node_modules/
dist/

# ملفات نظام التشغيل
.DS_Store

# أداة اختبار الموبايل (تجريبي فقط — لا يُرفَع أبداً)
.mobile-audit/

# نسخ احتياطية من ملف البيئة (أسرار اتصال) — تفضل خارج الجيت دائماً
.env.aiven-backup
.env.neon-backup

# نسخ احتياطية من قاعدة البيانات — ما تترفعش للمستودع أبداً
*.backup
*.dump

# 🔒 ملفات توكنات جلسة مؤقتة (لا تُحفظ في المستودع إطلاقاً): توكن صالح المفروض
#    يكون في ذاكرة المتصفح أو متغيرات البيئة الموزّعة، لا في ملف داخل الريبو.
_token.txt
.dev_token.tmp
*.dev_token.tmp

# ملفات السجلات — بتتغيّر كل ثانية فتعمل كوميتات ضجيج
*.log

# 🔒 مخرجات تشغيل محلية تحتوي توكن جلسة (تُولَّد بـ _make_seed.py) — لا تُحفظ في المستودع
_seed.json
